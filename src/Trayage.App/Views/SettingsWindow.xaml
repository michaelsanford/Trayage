<ui:FluentWindow x:Class="Trayage.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:vm="clr-namespace:Trayage.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
                 Title="Trayage Settings"
                 Width="760"
                 Height="620"
                 MinWidth="620"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <!-- One account's card on the Accounts page. Collapsed it shows the brand mark, the
             account's name, and where it lives; expanded it holds everything specific to that
             account — including the device-code block, which used to render outside the card. -->
        <DataTemplate x:Key="AccountCardTemplate" DataType="{x:Type vm:ProviderAccountViewModel}">
            <ui:CardExpander Style="{StaticResource SettingsCardExpanderStyle}"
                             Expanded="OnAccountExpanded">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand mark, tinted per provider by the triggers below. -->
                        <Path x:Name="BrandMark"
                              Grid.Column="0"
                              Data="{StaticResource GitHubMarkGeometry}"
                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                              Stretch="Uniform" Width="22" Height="22"
                              VerticalAlignment="Center" Margin="0,0,14,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SubtitleLabel}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- Status dot + word, so connection state reads at a glance. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0"
                                     Fill="{DynamicResource TextFillColorDisabledBrush}" />
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel Margin="0,4,0,0">
                    <ProgressBar Style="{StaticResource BusyProgressStyle}"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Connect / disconnect. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button Content="Connect"
                                   Appearance="Primary"
                                   Command="{Binding ConnectCommand}"
                                   IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                                   Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Content="Disconnect"
                                   Command="{Binding DisconnectCommand}"
                                   Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Remove"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Margin="8,0,0,0"
                                   ToolTip="Forget this account and delete its stored token"
                                   Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>

                    <!-- Device-code / status block, now inside the card it belongs to. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyStringToCollapsed}}">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding UserCode, Converter={StaticResource EmptyStringToCollapsed}}">
                            <ui:TextBox Text="{Binding UserCode, Mode=OneWay}"
                                        IsReadOnly="True"
                                        FontFamily="Cascadia Mono, Consolas, monospace"
                                        FontSize="18"
                                        MinWidth="150"
                                        VerticalContentAlignment="Center" />
                            <ui:Button Content="Copy"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       Margin="8,0,0,0"
                                       Command="{Binding CopyCodeCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Everything below only makes sense once the account is connected. -->
                    <StackPanel Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="Name" Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock Text="What to call this account in Settings and beside its inbox items. Leave blank to use the login."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,0,0,6" />
                        <ui:TextBox PlaceholderText="Work, Personal, …"
                                    Text="{Binding Nickname, UpdateSourceTrigger=LostFocus}"
                                    MaxWidth="280"
                                    HorizontalAlignment="Left" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,8">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Include in the inbox" FontWeight="SemiBold" />
                                    <TextBlock Text="Turn off to pause this account without disconnecting it — the token is kept."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" />
                        </ui:CardControl>

                        <!-- Bitbucket only: the watched-repo picker, scoped to this account. -->
                        <StackPanel Visibility="{Binding SupportsRepoPicker, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Watched repositories" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Bitbucket has no notification inbox, so Trayage watches the repositories you pick here — surfacing their pull requests, review requests, and activity. These are watched with this account's access only."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0"
                                           Content="Refresh"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           ToolTip="Reload the repositories this account can reach"
                                           Command="{Binding LoadReposCommand}"
                                           IsEnabled="{Binding IsLoadingRepos, Converter={StaticResource InverseBool}}"
                                           Margin="0,0,8,0" />
                                <ui:TextBox Grid.Column="1"
                                            PlaceholderText="Filter…"
                                            Text="{Binding RepoFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <ProgressBar Style="{StaticResource BusyProgressStyle}"
                                         Visibility="{Binding IsLoadingRepos, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding RepoLoadStatus}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding RepoLoadStatus, Converter={StaticResource EmptyStringToCollapsed}}" />

                            <!-- Bounded and virtualizing: a large Bitbucket account would
                                 otherwise realize every row into the page's scroll viewer. -->
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding RepoView}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <!-- Collapsed by default so large accounts aren't a wall of repos;
                                                                     a typed filter auto-expands groups so matches are visible. -->
                                                                <Expander Margin="0,0,0,4"
                                                                          IsExpanded="{Binding DataContext.RepoFilterActive, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}">
                                                                    <Expander.Header>
                                                                        <StackPanel Orientation="Horizontal" d:DataContext="{d:DesignInstance CollectionViewGroup}">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter Margin="12,4,0,4" />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WatchedRepoOption}">
                                            <!-- Compact one-line row (workspace is already the group header),
                                                 so large accounts list densely instead of a wall of cards. -->
                                            <Grid Margin="0,3,8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullName}" />
                                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWatched}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Add a repository manually" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="For a repository the loader can't reach. It joins the watched list above (toggle it off there to stop watching)."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            PlaceholderText="owner/repo or a Bitbucket URL"
                                            Text="{Binding NewWatchedRepo, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,8,0" />
                                <ui:Button Grid.Column="1"
                                           Content="Add"
                                           Appearance="Secondary"
                                           Command="{Binding AddWatchedRepoCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding WatchedRepoError}"
                                       Style="{StaticResource ErrorTextStyle}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding WatchedRepoError, Converter={StaticResource EmptyStringToCollapsed}}" />
                        </StackPanel>

                        <!-- GitHub and GitLab: what used to be whole informational tabs. Their
                             inboxes are server-side, so the controls live on the provider. -->
                        <StackPanel Visibility="{Binding SupportsRepoPicker, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock x:Name="ServerSideHeader" Text="Where this inbox comes from" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Name="ServerSideBlurb"
                                       Text="Your GitHub items mirror your GitHub notifications inbox. To choose which repositories notify you, manage watching and notification preferences on GitHub itself — Trayage shows whatever GitHub delivers."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,0,0,8" />
                            <ui:HyperlinkButton x:Name="ServerSideLink1" Content="Open your GitHub notifications inbox"
                                                NavigateUri="https://github.com/notifications" />
                            <ui:HyperlinkButton x:Name="ServerSideLink2" Content="Manage which repositories you watch"
                                                NavigateUri="https://github.com/watching" />
                            <ui:HyperlinkButton x:Name="ServerSideLink3" Content="GitHub notification settings"
                                                NavigateUri="https://github.com/settings/notifications" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </ui:CardExpander>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Provider}" Value="Bitbucket">
                    <Setter TargetName="BrandMark" Property="Data" Value="{StaticResource BitbucketMarkGeometry}" />
                    <Setter TargetName="BrandMark" Property="Fill" Value="{StaticResource BitbucketBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Provider}" Value="GitLab">
                    <Setter TargetName="BrandMark" Property="Data" Value="{StaticResource GitLabMarkGeometry}" />
                    <Setter TargetName="BrandMark" Property="Fill" Value="{StaticResource GitLabOrangeBrush}" />
                    <Setter TargetName="ServerSideBlurb" Property="Text"
                            Value="Your GitLab items mirror your GitLab To-Do list. To choose what creates a to-do, manage your notification settings on GitLab itself — Trayage shows whatever GitLab delivers." />
                    <Setter TargetName="ServerSideLink1" Property="Content" Value="Open your GitLab To-Do list" />
                    <Setter TargetName="ServerSideLink1" Property="NavigateUri" Value="https://gitlab.com/dashboard/todos" />
                    <Setter TargetName="ServerSideLink2" Property="Content" Value="GitLab notification settings" />
                    <Setter TargetName="ServerSideLink2" Property="NavigateUri" Value="https://gitlab.com/-/profile/notifications" />
                    <Setter TargetName="ServerSideLink3" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Connected}" Value="True" />
                        <Condition Binding="{Binding IsEnabled}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Trayage Settings" />

        <Grid Grid.Row="1" Margin="12,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail. A ListBox rather than ui:NavigationView: the panes share one
                 DataContext and one view-model, so there is nothing to navigate between —
                 this just selects which pane is visible. -->
            <ListBox x:Name="Nav"
                     Grid.Column="0"
                     Width="168"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="OnNavigationSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Fluent's selection pill on the leading edge. -->
                                            <Rectangle x:Name="Pill"
                                                       Grid.Column="0"
                                                       Width="3" RadiusX="1.5" RadiusY="1.5"
                                                       HorizontalAlignment="Left"
                                                       Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="Hidden" />
                                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Person24" Margin="0,0,10,0" />
                        <TextBlock Text="Accounts" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,10,0" />
                        <TextBlock Text="Notifications" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Mail24" Margin="0,0,10,0" />
                        <TextBlock Text="Inbox" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                        <TextBlock Text="General" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" />
                        <TextBlock Text="About" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- The rail selects which of these panes is visible; they are siblings rather than
                 navigated Pages so the whole window keeps one DataContext and one view-model. -->
            <Grid Grid.Column="1" Margin="16,0,0,0">

                <!-- ============================ Accounts ============================ -->
                <ScrollViewer x:Name="AccountsPane" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Accounts" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Connect as many accounts as you like — a work and a personal GitHub, two Bitbucket workspaces. Each keeps its own sign-in and its own watched repositories."
                                   Style="{StaticResource PageDescriptionTextStyle}" />

                        <ItemsControl ItemsSource="{Binding Accounts}"
                                      ItemTemplate="{StaticResource AccountCardTemplate}" />

                        <!-- Empty state, so a fresh install isn't a blank pane. -->
                        <StackPanel Margin="0,24,0,24"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="PersonAdd24" FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="No accounts yet. Add one to start filling your inbox."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <ui:DropDownButton Content="Add account"
                                           Icon="{ui:SymbolIcon Add24}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Left"
                                           Margin="0,8,0,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu ItemsSource="{Binding AddAccountOptions}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <!-- The menu lives in a popup outside the window's visual tree,
                                                 so reach the view-model through the button the menu is
                                                 placed on rather than an ancestor DataContext lookup. -->
                                            <Setter Property="Command"
                                                    Value="{Binding PlacementTarget.DataContext.AddAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================== Notifications ========================== -->
                <ScrollViewer x:Name="NotificationsPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Choose which kinds of activity notify you, and how."
                                   Style="{StaticResource PageDescriptionTextStyle}" />

                        <!-- Shown only when the OS can't deliver toasts (Windows App Runtime missing).
                             Trayage still tracks the inbox in the tray; this offers the one-click fix. -->
                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ToastsUnavailable, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Title="Notifications unavailable"
                                        Message="Windows toasts need the Windows App Runtime, which isn't installed on this PC. Trayage still tracks your inbox from the tray — install the runtime to turn on pop-up notifications, then reopen Settings." />
                            <ui:Button Content="Get the Windows App Runtime"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Margin="0,8,0,0"
                                       Command="{Binding OpenNotificationRuntimeHelpCommand}" />
                        </StackPanel>

                        <TextBlock Text="Delivery" Style="{StaticResource SectionHeaderTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Notification style" FontWeight="SemiBold" />
                                    <TextBlock Text="Show a toast, play a sound, or both."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding NotificationStyleOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Style"
                                      SelectedValue="{Binding SelectedNotificationStyle}"
                                      MinWidth="160" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Notification sound" FontWeight="SemiBold" />
                                    <TextBlock Text="Which audio ping plays for new activity."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding NotificationSounds}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedNotificationSound}"
                                      IsEnabled="{Binding SoundSelectionEnabled}"
                                      MinWidth="160" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}" IsEnabled="{Binding SoundSelectionEnabled}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Notification volume" FontWeight="SemiBold" />
                                    <TextBlock Text="How loud the audio alert plays."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Grid MinWidth="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <!-- The readout tracks the thumb live, but the value is only saved
                                     (and previewed) once the drag ends — otherwise every pixel of
                                     travel rewrote settings.json and replayed the sound. -->
                                <Slider x:Name="VolumeSlider"
                                        Grid.Column="0"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="5"
                                        LargeChange="10"
                                        TickFrequency="5"
                                        Value="{Binding NotificationVolume, UpdateSourceTrigger=PropertyChanged}"
                                        Thumb.DragCompleted="OnVolumeDragCompleted"
                                        ValueChanged="OnVolumeValueChanged"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NotificationVolume, StringFormat='{}{0}%'}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                            </Grid>
                        </ui:CardControl>

                        <TextBlock Text="What to notify me about" Style="{StaticResource SectionHeaderTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Review requests" FontWeight="SemiBold" />
                                    <TextBlock Text="Someone asked you to review a pull request."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding NotifyReviewRequests}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Mentions and assignments" FontWeight="SemiBold" />
                                    <TextBlock Text="You were @-mentioned, or an issue or PR was assigned to you."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding NotifyMentions}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="CI / check status changes" FontWeight="SemiBold" />
                                    <TextBlock Text="A build or check finished on one of your pull requests."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding NotifyCi}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="All activity on watched repositories" FontWeight="SemiBold" />
                                    <TextBlock Text="Anything at all in the repositories you watch, even when you're not involved."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding NotifyWatchedRepoActivity}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Issues &amp; PRs I'm involved in" FontWeight="SemiBold" />
                                    <TextBlock Text="Follow-up activity on threads you authored or joined."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding NotifyParticipating}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== Inbox ============================== -->
                <ScrollViewer x:Name="InboxPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Inbox" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="How the tray flyout lays out and filters what it shows."
                                   Style="{StaticResource PageDescriptionTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Group by repository" FontWeight="SemiBold" />
                                    <TextBlock Text="Group inbox items under each repository. Off shows a single newest-first list."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding GroupByRepository}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Show read items" FontWeight="SemiBold" />
                                    <TextBlock Text="Keep already-read items in the inbox (dimmed). Off shows only unread items."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowReadItems}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Surface recently-modified items" FontWeight="SemiBold" />
                                    <TextBlock Text="Show and notify on recently-updated items even if GitHub already marks them read (within ~2× the poll interval)."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding SurfaceRecentlyModified}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================= General ============================= -->
                <ScrollViewer x:Name="GeneralPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="How often Trayage checks in, how it looks, and how it starts."
                                   Style="{StaticResource PageDescriptionTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Check for new activity every" FontWeight="SemiBold" />
                                    <TextBlock Text="Applies to every account. A provider may ask for a slower floor."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding PollIntervalOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Seconds"
                                      SelectedValue="{Binding PollIntervalSeconds}"
                                      MinWidth="120" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      MinWidth="120" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                    <TextBlock Text="Launch Trayage automatically when you sign in."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
                        </ui:CardControl>

                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Verbose logging" FontWeight="SemiBold" />
                                    <TextBlock Text="Capture detailed (debug) logs for bug reports. Applies after restart."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding VerboseLogging}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Diagnostic logs" FontWeight="SemiBold" />
                                    <TextBlock Text="Stored locally; contain no account names or tokens, so they're safe to attach to a bug report."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open logs folder"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Command="{Binding OpenLogsCommand}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== About ============================== -->
                <ScrollViewer x:Name="AboutPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Trayage gathers your GitHub, Bitbucket Cloud, and GitLab activity into one tray inbox."
                                   Style="{StaticResource PageDescriptionTextStyle}" />

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Version" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MonoCaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Releases"
                                       Icon="{ui:SymbolIcon Tag24}"
                                       Command="{Binding OpenReleasesCommand}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCardStyle}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Source and issues" FontWeight="SemiBold" />
                                    <TextBlock Text="Every release ships with build provenance, a cosign signature, and an SBOM."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="Open on GitHub"
                                       Icon="{ui:SymbolIcon Open24}"
                                       Command="{Binding OpenProjectCommand}" />
                        </ui:CardControl>

                        <TextBlock Text="Your tokens are encrypted at rest with Windows DPAPI and never leave this machine. Logs stay local and never contain tokens."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="2,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
