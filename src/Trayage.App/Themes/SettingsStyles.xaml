<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Shared typography and card chrome for the Settings window. Previously every pane
         repeated the same inline FontSize/FontWeight/Foreground/Margin attributes; these
         styles are the single place to change the look. -->

    <!-- The heading at the top of a settings page. -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- The sentence under a page heading that says what the page is for. -->
    <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- A group heading inside a page, separating stacks of cards. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,8,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- The bold title line of a card. Foreground is explicit: inside a CardExpander header the
         inherited Foreground isn't the primary text brush, so a bare TextBlock renders
         dark-on-dark in dark mode. -->
    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Secondary/metadata text: card sub-lines, status messages, hints. -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Monospace metadata, matching the inbox flyout's treatment of codes and counts. -->
    <Style x:Key="MonoCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Uniform vertical rhythm for the card stacks that make up every page.

         These MUST derive from WPF-UI's implicit style. Applying a keyed style to a themed
         control replaces the implicit one wholesale — including its ControlTemplate — which
         silently drops the card chrome and stops the Header from rendering at all. -->
    <Style x:Key="SettingsCardStyle" TargetType="ui:CardControl"
           BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SettingsCardExpanderStyle" TargetType="ui:CardExpander"
           BasedOn="{StaticResource {x:Type ui:CardExpander}}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The 2px indeterminate progress bar the inbox flyout uses for its busy state, so a
         loading Settings pane reads the same way. -->
    <Style x:Key="BusyProgressStyle" TargetType="ProgressBar"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
