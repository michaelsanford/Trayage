<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal test seams (e.g. InboxPollingService.PollOnceAsync/NextInterval) to the test project. -->
    <InternalsVisibleTo Include="Trayage.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting/Logging abstractions and Options ship in the .NET 11 shared framework (NU1510). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
